# Получить у @BotFather после /newbot
TELEGRAM_BOT_TOKEN=

# Случайная строка (генерация: openssl rand -hex 32). Используется для валидации
# заголовка X-Telegram-Bot-Api-Secret-Token, который Telegram присылает на наш
# вебхук. Также используется как ключ доступа к /api/setup.
TELEGRAM_WEBHOOK_SECRET=

# Числовой ID канала (вида -100xxxxxxxxxx)
CHANNEL_ID=

# Числовой ID привязанного чата обсуждения (вида -100xxxxxxxxxx)
CHAT_ID=

# Твой личный user_id (положительное число). Используется как «владелец»:
# личка с ботом только с этого аккаунта; /start /help /ping /status — только ты.
# Личный user_id владельца: /start /help /ping /status и тех. логи (ошибки).
ADMIN_LOG_CHAT_ID=

# Супергруппа модерации: карточки «подозрительная реакция» с кнопками и логи банов.
MODERATION_CHAT_ID=

# Upstash Redis (REST) — сессии модерации и автобан по 2+ реакциям на Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Ниже — опциональные переменные. Пустые можно не задавать.
# ---------------------------------------------------------------------------

# Среда бота: prod | staging. Влияет только на видимость (логи, /api/health),
# поведение одинаковое. Дефолт prod.
BOT_ENV=

# ---- LLM-режим «Авантюрин общается в чате» ----
# Если LLM_API_KEY пустой — режим выключен, бот работает только как модератор.

# Ключ провайдера LLM (OpenAI / Anthropic / OpenRouter).
LLM_API_KEY=

# Провайдер: openai | anthropic | openrouter. Дефолт openai.
LLM_PROVIDER=

# Модель. Дефолты:
#   openai      -> gpt-4o-mini
#   anthropic   -> claude-3-5-haiku-latest
#   openrouter  -> openai/gpt-4o-mini
# Рекомендация: gpt-4.1-mini для OpenAI (умнее gpt-4o-mini за ~3x цену).
LLM_MODEL=

# Максимум output-токенов на один ответ (жёсткий потолок). Дефолт 360.
LLM_MAX_OUTPUT_TOKENS=

# Таймаут одного запроса к LLM в миллисекундах. Дефолт 15000.
LLM_TIMEOUT_MS=

# Сколько последних сообщений чата класть в контекст ответа. Дефолт 4.
# Буфер хранит до 20 последних сообщений, так что значения >20 не имеют смысла.
LLM_CONTEXT_MESSAGES=

# Таймзона для «календарных суток» лимитов. Сейчас поддерживается Europe/Moscow.
CHAT_TZ=

# Каждое N-ное сообщение в чате — попытка вставить «рандомный» ответ от Авантюрина.
# Дефолт 15 (в коде). Учитывай активность чата: при ~1600 сообщений/день и N=30
# «попыток» получается ~53, ограничение CHAT_DAILY_RANDOM_CAP режет сверху.
CHAT_RANDOM_EVERY_N=

# Потолок «рандомных» ответов на весь чат в сутки. Дефолт 50.
CHAT_DAILY_RANDOM_CAP=

# Потолок ответов на одного пользователя в сутки (триггер «Авантюрин» +
# продолжение диалога реплаем на бота). Дефолт 5.
CHAT_USER_DAILY_CAP=
