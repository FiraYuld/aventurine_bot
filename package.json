{
  "name": "avanturin-bot",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Open-source Telegram bot: reaction moderation for channel-linked discussion groups",
  "repository": {
    "type": "git",
    "url": "https://github.com/FiraYuld/aventurine_bot.git"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "moderation",
    "grammy",
    "vercel",
    "spam",
    "reactions"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "verify:e2e": "tsx --test tests/e2e/webhook.test.ts",
    "local": "vercel dev",
    "deploy": "vercel --prod",
    "analysis:stats": "node --env-file=.env --import tsx tools/chat-analysis/01-parse-stats.ts",
    "analysis:samples": "node --env-file=.env --import tsx tools/chat-analysis/02-build-samples.ts",
    "analysis:dossier": "node --env-file=.env --import tsx tools/chat-analysis/03-llm-dossier.ts",
    "analysis:compile": "node --env-file=.env --import tsx tools/chat-analysis/04-compile-lore.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vercel": "^51.7.0"
  }
}
